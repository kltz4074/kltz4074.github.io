---
import '../styles/site.css';
import '../styles/pages.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, devlog, sectionEnabled } from '../lib/portfolio';
import type { Seo } from '../lib/schema';

interface Props { title: string; description?: string; seo?: Seo; home?: boolean; noindex?: boolean }
const { title, description, seo, home = false, noindex = false } = Astro.props;
const pageTitle = seo?.title || (home ? title : title + ' — ' + site.name);
const pageDescription = seo?.description || description || site.seo.description || site.name;
const image = new URL(seo?.image || site.seo.image || site.hero, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const structured = JSON.stringify({ '@context': 'https://schema.org', '@type': home ? 'WebSite' : 'WebPage', name: pageTitle, description: pageDescription, url: canonical }).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <style is:inline>
      .page-curtain {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        pointer-events: none;
        visibility: hidden;
        background: linear-gradient(165deg, #30223e, #17141e 65%);
        transform: translateY(100%);
      }

      html[data-page-arriving] .page-curtain {
        visibility: visible;
        animation: uncover-page 540ms cubic-bezier(.76,0,.24,1) both;
      }

      @keyframes uncover-page {
        from { transform: translateY(0); }
        to { transform: translateY(-101%); }
      }

      html[data-reduced] .page-curtain { display: none; }
      @media (prefers-reduced-motion: reduce) { .page-curtain { display: none; } }
    </style>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          root.toggleAttribute('data-reduced', matchMedia('(prefers-reduced-motion: reduce)').matches ||
            localStorage.getItem('kltzqu-reduced-motion') === 'true');
        } catch {}
        const navigation = performance.getEntriesByType('navigation')[0];
        const internal = document.referrer && new URL(document.referrer).origin === location.origin;
        if (!root.hasAttribute('data-reduced') && (navigation?.type === 'back_forward' || (navigation?.type === 'navigate' && internal))) {
          root.setAttribute('data-page-arriving', '');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={site.avatar} />
    {sectionEnabled('devlog') && devlog.length > 0 && <link rel="alternate" type="application/rss+xml" title="Devlog" href="/rss.xml" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={image} />
    <script is:inline type="application/ld+json" set:html={structured}></script>
    <slot name="head" />
  </head>
  <body id="top">
    <div class="page-curtain" aria-hidden="true"></div>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const curtain = document.querySelector('.page-curtain');
        const reduced = () => root.hasAttribute('data-reduced') || matchMedia('(prefers-reduced-motion: reduce)').matches;
        let outgoing;
        let recover;
        const clearArrival = () => root.removeAttribute('data-page-arriving');

        curtain.addEventListener('animationend', clearArrival);
        window.addEventListener('pageshow', ({ persisted }) => {
          if (persisted && !reduced()) root.setAttribute('data-page-arriving', '');
        });
        window.addEventListener('pagehide', () => {
          clearTimeout(recover);
          outgoing?.cancel();
          outgoing = undefined;
          clearArrival();
        });

        document.addEventListener('click', event => {
          const anchor = event.target instanceof Element && event.target.closest('a[href]');
          if (!anchor || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey ||
              event.shiftKey || event.altKey || (anchor.target && anchor.target !== '_self') ||
              anchor.hasAttribute('download') || reduced() || typeof curtain.animate !== 'function') return;

          const url = new URL(anchor.href, location.href);
          const internal = url.origin === location.origin;
          const itchGame = url.protocol === 'https:' && /^[a-z0-9-]+\.itch\.io$/i.test(url.hostname) && url.pathname !== '/';
          if ((!internal && !itchGame) || (internal && url.pathname === location.pathname && url.search === location.search) ||
              (internal && /\.[a-z0-9]+$/i.test(url.pathname) && !url.pathname.endsWith('.html'))) return;

          event.preventDefault();
          if (outgoing) return;
          clearArrival();
          outgoing = curtain.animate([
            { visibility: 'visible', transform: 'translateY(101%)' },
            { visibility: 'visible', transform: 'translateY(0)' },
          ], { duration: 300, easing: 'cubic-bezier(.76,0,.24,1)', fill: 'forwards' });
          outgoing.finished.then(() => {
            location.assign(url.href);
            recover = setTimeout(() => {
              outgoing?.cancel();
              outgoing = undefined;
            }, 1800);
          }, () => {});
        });
      })();
    </script>
    <Nav />
    <slot />
    <Footer full={home} />
  </body>
</html>
