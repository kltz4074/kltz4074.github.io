---
import '../styles/site.css';
import '../styles/pages.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, devlog, sectionEnabled } from '../lib/portfolio';
import type { Seo } from '../lib/schema';

interface Props { title: string; description?: string; seo?: Seo; home?: boolean; noindex?: boolean }
const { title, description, seo, home = false, noindex = false } = Astro.props;
const pageTitle = seo?.title || (home ? title : title + ' — ' + site.name);
const pageDescription = seo?.description || description || site.seo.description || site.name;
const image = new URL(seo?.image || site.seo.image || site.hero, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const structured = JSON.stringify({ '@context': 'https://schema.org', '@type': home ? 'WebSite' : 'WebPage', name: pageTitle, description: pageDescription, url: canonical }).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <style is:inline>@view-transition { navigation: auto; }</style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={site.avatar} />
    {sectionEnabled('devlog') && devlog.length > 0 && <link rel="alternate" type="application/rss+xml" title="Devlog" href="/rss.xml" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={image} />
    <script is:inline type="application/ld+json" set:html={structured}></script>
    <slot name="head" />
  </head>
  <body id="top">
    <script is:inline>
      try {
        document.documentElement.toggleAttribute('data-reduced', matchMedia('(prefers-reduced-motion: reduce)').matches || localStorage.getItem('kltzqu-reduced-motion') === 'true');
      } catch {}
      function sharedCover(activation) {
        const projectPath = /^\/projects\/([a-z0-9-]+)\/?$/;
        const slug = [activation?.entry?.url, activation?.from?.url]
          .map(url => url && new URL(url).pathname.match(projectPath)?.[1])
          .find(Boolean);
        if (!slug) return;

        const cover = document.querySelector('[data-project-cover="' + slug + '"]');
        const stage = document.querySelector('.hero-stage');
        const active = document.querySelector('[data-reel-link]')?.pathname;
        const onScreen = element => {
          if (!element) return false;
          const bounds = element.getBoundingClientRect();
          return bounds.bottom > 0 && bounds.top < innerHeight;
        };
        const chosen = onScreen(cover) ? cover : active === '/projects/' + slug + '/' && onScreen(stage) ? stage : null;
        if (!chosen) return;
        chosen.style.viewTransitionName = 'selected-project';
        return () => { chosen.style.viewTransitionName = ''; };
      }

      let nativeArrival = false;
      window.addEventListener('pageshow', event => {
        const internal = document.referrer && new URL(document.referrer).origin === location.origin;
        const history = performance.getEntriesByType('navigation')[0]?.type === 'back_forward';
        if (nativeArrival || !(event.persisted || history || internal)) return;
        const main = document.querySelector('main');
        if (!main || document.documentElement.hasAttribute('data-reduced') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        main.animate([{ opacity: .55, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }], {
          duration: 340,
          easing: 'cubic-bezier(.22,.72,.18,1)',
        });
      });
      window.addEventListener('pagehide', () => { nativeArrival = false; });

      for (const phase of ['pageswap', 'pagereveal']) {
        window.addEventListener(phase, event => {
          const transition = event.viewTransition;
          if (!transition) return;
          if (phase === 'pagereveal') nativeArrival = true;
          transition.ready.catch(() => {});
          if (document.documentElement.hasAttribute('data-reduced')) {
            transition.skipTransition();
            return;
          }
          const reset = sharedCover(event.activation ?? window.navigation?.activation);
          if (reset) transition.finished.then(reset, reset);
        });
      }
    </script>
    <Nav />
    <slot />
    <Footer full={home} />
  </body>
</html>
