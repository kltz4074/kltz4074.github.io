---
import Base from '../../layouts/Base.astro';
import Copy from '../../components/Copy.astro';
import Media from '../../components/Media.astro';
import { projects, devlog, lab, english, sectionEnabled } from '../../lib/portfolio';
import type { Project } from '../../lib/schema';
export function getStaticPaths() {
  return sectionEnabled('projects') ? projects.map(project => ({ params: { slug: project.slug }, props: { project } })) : [];
}
const { project }: { project: Project } = Astro.props;
const frames = [...project.media ?? [], ...lab.filter(entry => entry.project === project.slug).flatMap(entry => entry.media ?? [])];
if (project.cover && !frames.some(frame => frame.src === project.cover)) frames.unshift({ src: project.cover, alt: project.title });
const posts = sectionEnabled('devlog') ? devlog.filter(post => post.project === project.slug) : [];
---
<Base title={project.title} description={english(project.summary)} seo={{ image: project.cover || undefined, ...project.seo }}>
  <main id="main" class="page-gutter interior">
    <a class="back-link" href="/projects/">← All projects</a>
    <h1>{project.title}<span>.</span></h1>
    <div class="detail-lead">
      <p class="lede"><Copy copy={project.summary} /></p>
      <dl class="facts">
        <div><dt>Category</dt><dd>{project.category}</dd></div>
        <div><dt>Status</dt><dd>{project.archived ? 'Archived' : project.status}</dd></div>
        {project.role && <div><dt>My role</dt><dd>{project.role}</dd></div>}
        {project.tech?.length && <div><dt>Tools</dt><dd>{project.tech.join(', ')}</dd></div>}
        {project.created && <div><dt>Created</dt><dd>{project.created}</dd></div>}
        {project.updated && <div><dt>Updated</dt><dd><time datetime={project.updated}>{project.updated}</time></dd></div>}
        {project.tags?.length && <div><dt>Tags</dt><dd>{project.tags.join(', ')}</dd></div>}
      </dl>
    </div>
    {project.links?.length && <nav class="detail-links" aria-label="Project links">{project.links.map(link => <a href={link.url}>{link.label} ↗</a>)}</nav>}
    <Media frames={frames} />
    {english(project.body) && <section class="prose"><h2>About the project</h2><Copy copy={project.body} rich /></section>}
    {english(project.updates) && <section class="prose"><h2>Updates</h2><Copy copy={project.updates} rich /></section>}
    {posts.length > 0 && <section class="prose"><h2>Devlog</h2><ul>{posts.map(post => <li><a href={'/devlog/' + post.slug + '/'}>{post.title}</a></li>)}</ul></section>}
  </main>
</Base>
