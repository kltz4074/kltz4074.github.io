---
import Arrow from '../../components/Arrow.astro';
import Base from '../../layouts/Base.astro';
import Copy from '../../components/Copy.astro';
import Media from '../../components/Media.astro';
import { projects, devlog, lab, english, isVideo, sectionEnabled } from '../../lib/portfolio';
import { label } from '../../lib/labels';
import type { Project } from '../../lib/schema';
export function getStaticPaths() {
  return sectionEnabled('projects') ? projects.map(project => ({ params: { slug: project.slug }, props: { project } })) : [];
}
const { project }: { project: Project } = Astro.props;
const frames = [...project.media ?? [], ...lab.filter(entry => entry.project === project.slug).flatMap(entry => entry.media ?? [])];
if (project.cover && !frames.some(frame => frame.src === project.cover)) frames.unshift({ src: project.cover, alt: project.title });
const cover = frames.find(frame => frame.src === project.cover && !isVideo(frame.src)) ?? frames.find(frame => !isVideo(frame.src));
const posts = sectionEnabled('devlog') ? devlog.filter(post => post.project === project.slug) : [];
const queue = projects.filter(item => !item.archived);
const next = queue.length > 1 ? queue[(queue.findIndex(item => item.slug === project.slug) + 1) % queue.length] : undefined;
const related = projects.find(item => ({ 'the-dev-blog': 'backos', backos: 'the-dev-blog' })[project.slug] === item.slug);
const url = (slug: string) => '/projects/' + slug + '/';
---
<Base title={project.title} description={english(project.summary)} seo={{ image: cover?.src, ...project.seo }}>
  <main id="main" class="page-gutter interior" tabindex="-1">
    <a class="back-link" href="/projects/">← <Copy copy={label('All projects', 'Все проекты')} /></a>
    <h1>{project.title}</h1>
    <div class="detail-lead">
      <p class="lede"><Copy copy={project.summary} /></p>
      <dl class="facts">
        <div><dt><Copy copy={label('Category', 'Категория')} /></dt><dd><Copy copy={label(project.category)} /></dd></div>
        <div><dt><Copy copy={label('Status', 'Статус')} /></dt><dd><Copy copy={label(project.archived ? 'Archived' : project.status)} /></dd></div>
        {project.role && <div><dt><Copy copy={label('My role', 'Моя роль')} /></dt><dd><Copy copy={label(project.role)} /></dd></div>}
        {project.tech?.length && <div><dt><Copy copy={label('Tools', 'Стек')} /></dt><dd>{project.tech.join(', ')}</dd></div>}
        {project.created && <div><dt><Copy copy={label('Started', 'Начало')} /></dt><dd><Copy copy={label(project.created)} /></dd></div>}
        {project.updated && <div><dt><Copy copy={label('Updated', 'Обновлено')} /></dt><dd><time datetime={project.updated}>{project.updated}</time></dd></div>}
        {project.tags?.length && <div><dt><Copy copy={label('Tags', 'Теги')} /></dt><dd>{project.tags.join(', ')}</dd></div>}
      </dl>
    </div>
    {(project.links?.length || related) && <nav class="detail-links" aria-label="Project links" data-label-ru="Ссылки на проект">{project.links?.map(link => <a class="action" href={link.url}><Copy copy={label(link.label)} /><Arrow /></a>)}{related && <a class="action" href={url(related.slug)}>{related.title}<Arrow /></a>}</nav>}
    {cover && <a class="detail-cover" href={cover.src} data-lightbox style={`view-transition-name: project-${project.slug}`} aria-label={'Open image: ' + cover.alt} data-label-ru="Открыть изображение">
      <img src={cover.src} alt={cover.alt} width="1440" height="810" fetchpriority="high" />
    </a>}
    {english(project.body) && <section class="prose"><h2><Copy copy={label('About the project', 'О проекте')} /></h2><Copy copy={project.body} rich /></section>}
    <Media frames={frames.filter(frame => frame !== cover)} secondary={!!cover} />
    {english(project.updates) && <section class="prose"><h2><Copy copy={label('Updates', 'Обновления')} /></h2><Copy copy={project.updates} rich /></section>}
    {posts.length > 0 && <section class="prose"><h2><Copy copy={label('Devlog')} /></h2><ul>{posts.map(post => <li><a href={'/devlog/' + post.slug + '/'}>{post.title}</a></li>)}</ul></section>}
    {next && <div class="detail-next"><a class="action" href="/projects/">← <Copy copy={label('All projects', 'Все проекты')} /></a><a class="action" href={url(next.slug)}>{next.title}<Arrow moving /></a></div>}
  </main>
</Base>
