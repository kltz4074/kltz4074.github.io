---
import Arrow from '../components/Arrow.astro';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Project from '../components/Project.astro';
import Copy from '../components/Copy.astro';
import { site, projects, devlog, portfolio, showNow, sectionEnabled } from '../lib/portfolio';
import { label } from '../lib/labels';

const visible = sectionEnabled('projects') ? projects.filter(project => !project.archived) : [];
const featured = visible.filter(project => project.featured);
const other = visible.filter(project => !project.featured);
---
<Base title={site.name + ' — Portfolio'} seo={site.seo} home>
  <main id="main" tabindex="-1">
    <Hero projects={featured.length ? featured : visible} />
    {visible.length > 0 && <section class="work page-gutter" id="work" aria-labelledby="work-title">
      <header class="work-heading">
        <h2 id="work-title"><span class="work-word"><Copy copy={featured.length ? label('Selected work', 'Избранные проекты') : label('Projects')} /></span></h2>
        <a class="action" href="/projects/"><Copy copy={label('All projects', 'Все проекты')} /><Arrow moving /></a>
      </header>
      {featured.map((project, index) => <Project project={project} reverse={index % 2 === 1} />)}
      {other.length > 0 && <div class="work-directory">
        {featured.length > 0 && <h3><Copy copy={label('More projects', 'Другие проекты')} /></h3>}
        <ul class="index-list">
          {other.map(project => <li><a href={'/projects/' + project.slug + '/'}>
            <strong>{project.title}</strong><span><Copy copy={project.summary} /></span>
            <span class="directory-end"><Copy copy={label(project.category)} /><Arrow /></span>
          </a></li>)}
        </ul>
      </div>}
    </section>}
    {sectionEnabled('about') && site.about.en && <section id="about" class="about page-gutter" aria-labelledby="about-title">
      <h2 id="about-title"><Copy copy={label('About me', 'Обо мне')} /></h2>
      <div class="about-copy">
        <Copy copy={site.about} rich />
        <a class="action" href="/about/"><Copy copy={label('More about me', 'Подробнее обо мне')} /><Arrow moving /></a>
      </div>
    </section>}
    {showNow && <section class="home-index page-gutter"><h2><a href="/now/"><Copy copy={label('Now')} /> ↗</a></h2><Copy copy={portfolio.now.body} rich /></section>}
    {sectionEnabled('devlog') && devlog.length > 0 && <section class="home-index page-gutter"><h2><a href="/devlog/"><Copy copy={label('Devlog')} /> ↗</a></h2><ul class="index-list">{devlog.slice(0, 3).map(post => <li><a href={'/devlog/' + post.slug + '/'}><strong>{post.title}</strong><time datetime={post.date}>{post.date}</time><Arrow /></a></li>)}</ul></section>}
  </main>
  <script>
    import '../motion';
  </script>
</Base>
