---
import { isVideo } from '../lib/portfolio';
import type { Frame } from '../lib/schema';
interface Props { frames: Frame[]; secondary?: boolean }
const { frames, secondary = false } = Astro.props;
---
{frames.length > 0 && <div class:list={['media-grid', { 'media-grid--secondary': secondary }]}>
  {frames.map(({src, alt}) => isVideo(src)
    ? <video controls playsinline preload="none" aria-label={alt || 'Project video'} data-label-ru="Видео проекта"><source src={src} /><a href={src}>Open video</a></video>
    : <a href={src} data-lightbox aria-label={alt ? 'Open image: ' + alt : 'Open image'} data-label-ru="Открыть изображение"><img loading="lazy" decoding="async" src={src} alt={alt} /></a>)}
</div>}
<script>
  const gallery = document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]');
  if (gallery.length) {
    const dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    const close = document.createElement('button');
    function localizeViewer() {
      const ru = document.documentElement.lang === 'ru';
      dialog.setAttribute('aria-label', ru ? 'Просмотр изображения' : 'Image viewer');
      close.textContent = ru ? 'Закрыть' : 'Close';
    }
    localizeViewer();
    document.addEventListener('portfolio:language', localizeViewer);
    const image = document.createElement('img');
    dialog.append(close, image);
    document.body.append(dialog);
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => image.removeAttribute('src'));
    for (const link of gallery) {
      link.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        image.alt = (link.querySelector<HTMLImageElement>('.project-frame:not([aria-hidden]):not([hidden]) img') ?? link.querySelector('img'))?.alt ?? '';
        image.src = link.href;
        dialog.showModal();
      });
    }
  }
</script>
